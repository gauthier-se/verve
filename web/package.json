{
  "name": "verve-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "i18n:extract": "i18next-cli extract && i18next-cli types",
    "i18n:check": "i18next-cli extract --ci --dry-run && i18next-cli lint",
    "i18n:status": "i18next-cli status",
    "generate:api": "openapi-ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "~5.3.0",
    "@tanstack/react-form": "~1.33.5",
    "@tanstack/react-query": "~5.107.1",
    "@tanstack/react-router": "~1.170.46",
    "@tanstack/react-table": "~9.3.1",
    "class-variance-authority": "~0.7.1",
    "cn": "~0.5.2",
    "i18next": "~26.5.10",
    "i18next-browser-languagedetector": "~8.3.0",
    "lucide-react": "~1.70.0",
    "radix-ui": "~1.8.1",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-i18next": "~17.1.8",
    "tw-animate-css": "~1.4.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "~0.99.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "~4.3.5",
    "@tanstack/eslint-plugin-query": "~5.107.1",
    "@tanstack/eslint-plugin-router": "~1.162.0",
    "@tanstack/router-plugin": "~1.169.0",
    "@testing-library/dom": "~10.4.2",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "~16.3.3",
    "@testing-library/user-event": "~14.6.8",
    "@types/node": "~26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~6.2.1",
    "@vitest/coverage-v8": "~5.1.0",
    "eslint": "~10.14.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-react-hooks": "~7.1.1",
    "i18next-cli": "~1.87.0",
    "jsdom": "~30.1.3",
    "msw": "~3.0.4",
    "prettier": "~3.9.10",
    "shadcn": "~4.23.0",
    "tailwindcss": "~4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.1",
    "vite": "~8.3.6",
    "vitest": "~5.1.0"
  }
}
