            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "description": "The maximum number of items of the page, at most 200: a larger limit counts as 200.",
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Keeps the events of this type.",
            "explode": false,
            "in": "query",
            "name": "type",
            "schema": {
              "description": "Keeps the events of this type.",
              "examples": [
                "admin.user_disabled"
              ],
              "type": "string"
            }
          },
          {
            "description": "Keeps the events of the user of this id as actor.",
            "explode": false,
            "in": "query",
            "name": "actor",
            "schema": {
              "description": "Keeps the events of the user of this id as actor.",
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Keeps the events about the user of this id.",
            "explode": false,
            "in": "query",
            "name": "subject",
            "schema": {
              "description": "Keeps the events about the user of this id.",
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Keeps the events that occurred at or after this time. An aggregated event is kept while its last occurrence is.",
            "explode": false,
            "in": "query",
            "name": "from",
            "schema": {
              "description": "Keeps the events that occurred at or after this time. An aggregated event is kept while its last occurrence is.",
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Keeps the events that occurred before this time, which must be after from. An aggregated event is kept when its first occurrence is.",
            "explode": false,
            "in": "query",
            "name": "to",
            "schema": {
              "description": "Keeps the events that occurred before this time, which must be after from. An aggregated event is kept when its first occurrence is.",
              "format": "date-time",
              "type": "string"
            }
          }
