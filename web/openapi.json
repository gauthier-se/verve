{
  "components": {
    "schemas": {
      "AuditEvent": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "$ref": "#/components/schemas/AuditUser",
            "description": "The user who acted, left out for the system."
          },
          "clientIp": {
            "description": "The IP address of the client, left out outside requests.",
            "examples": [
              "203.0.113.7"
            ],
            "type": "string"
          },
          "count": {
            "description": "The number of occurrences of the event, more than 1 for a burst aggregated into one event.",
            "examples": [
              1
            ],
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "description": "The id of the event.",
            "examples": [
              42
            ],
            "format": "int64",
            "type": "integer"
          },
          "lastAt": {
            "description": "When the last occurrence of the event happened, occurredAt unless the event is aggregated.",
            "format": "date-time",
            "type": "string"
          },
          "occurredAt": {
            "description": "When the event occurred, the first of its occurrences for an aggregated event.",
            "format": "date-time",
            "type": "string"
          },
          "payload": {
            "description": "The details of the event, an object whose fields depend on its type."
          },
          "subject": {
            "$ref": "#/components/schemas/AuditUser",
            "description": "The user the event is about, left out when there is none."
          },
          "type": {
            "description": "The type of the event.",
            "examples": [
              "auth.login_failed"
            ],
            "type": "string"
          },
          "userAgent": {
            "description": "The user agent of the client, left out outside requests.",
            "examples": [
              "Mozilla/5.0 (iPhone)"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "occurredAt",
          "type",
          "payload",
          "count",
          "lastAt"
        ],
        "type": "object"
      },
      "AuditUser": {
        "additionalProperties": false,
        "properties": {
          "deleted": {
            "description": "Whether the user was deleted since the event.",
            "type": "boolean"
          },
          "id": {
            "description": "The id of the user.",
            "examples": [
              1
            ],
            "format": "int64",
            "type": "integer"
          },
          "username": {
            "description": "The username, left out when the user was deleted.",
            "examples": [
              "alice"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "deleted"
        ],
        "type": "object"
      },
      "CurrentUser": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "description": "The email address, left out when the user has none.",
            "examples": [
              "alice@example.com"
            ],
            "type": "string"
          },
          "id": {
            "description": "The id of the user.",
            "examples": [
              1
            ],
            "format": "int64",
            "type": "integer"
          },
          "role": {
            "description": "The role of the user.",
            "enum": [
              "admin",
              "member"
            ],
            "examples": [
              "member"
            ],
            "type": "string"
          },
          "username": {
            "description": "The username, in the case it was created with.",
            "examples": [
              "alice"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "Meta": {
        "additionalProperties": false,
        "properties": {
          "buildDate": {
            "description": "When the server was built in RFC 3339 format, unknown for a development build.",
            "examples": [
              "2026-10-28T10:00:00Z"
            ],
            "type": "string"
          },
          "commit": {
            "description": "The commit the server was built from, unknown for a development build.",
            "examples": [
              "3f9a1c2"
            ],
            "type": "string"
          },
          "name": {
            "description": "The name of the application.",
            "examples": [
              "Verve"
            ],
            "type": "string"
          },
          "version": {
            "description": "The version of the server, dev for a development build.",
            "examples": [
              "1.4.0"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "commit",
          "buildDate"
        ],
        "type": "object"
      },
      "PageAuditEvent": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "description": "The items of the page, newest first.",
            "items": {
              "$ref": "#/components/schemas/AuditEvent"
            },
            "type": "array"
          },
          "nextCursor": {
            "description": "The cursor of the next page, left out on the last page.",
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "A stable machine-readable error code.",
            "type": "string"
          },
          "detail": {
            "description": "An explanation specific to this occurrence of the problem.",
            "type": "string"
          },
          "errors": {
            "description": "The individual errors behind the problem, for example one per invalid field.",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array"
          },
          "instance": {
            "description": "A URI reference that identifies this occurrence of the problem.",
            "type": "string"
          },
          "status": {
            "description": "The HTTP status code.",
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short summary of the problem type.",
            "type": "string"
          },
          "type": {
            "description": "A URI reference that identifies the problem type, about:blank when only the status matters.",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "description": "The session cookie set at login, named `__Host-verve_session` when the public URL uses https. A `POST`, `PUT`, `PATCH` or `DELETE` must also send the header `Verve-Csrf: 1` and an `Origin` matching the public URL.",
        "in": "cookie",
        "name": "verve_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Verve API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/account/audit": {
      "get": {
        "description": "Returns the audit events whose actor or subject is the user of the session, newest first.",
        "operationId": "list-account-audit-events",
        "parameters": [
          {
            "description": "The nextCursor of the previous page, left out for the first page.",
            "explode": false,
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "The nextCursor of the previous page, left out for the first page.",
              "type": "string"
            }
          },
          {
            "description": "The maximum number of items of the page, at most 200: a larger limit counts as 200.",
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "description": "The maximum number of items of the page, at most 200: a larger limit counts as 200.",
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageAuditEvent"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "summary": "List the audit events of the current user",
        "tags": [
          "Audit"
        ]
      }
    },
    "/api/v1/admin/audit": {
      "get": {
        "description": "Returns every audit event, newest first, for an admin. The filters combine.",
        "operationId": "list-admin-audit-events",
        "parameters": [
          {
            "description": "The nextCursor of the previous page, left out for the first page.",
            "explode": false,
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "The nextCursor of the previous page, left out for the first page.",
              "type": "string"
            }
          },
          {
            "description": "The maximum number of items of the page, at most 200: a larger limit counts as 200.",
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "description": "The maximum number of items of the page, at most 200: a larger limit counts as 200.",
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Keeps the events of this type.",
            "explode": false,
            "in": "query",
            "name": "type",
            "schema": {
              "description": "Keeps the events of this type.",
              "examples": [
                "admin.user_disabled"
              ],
              "type": "string"
            }
          },
          {
            "description": "Keeps the events of the user of this id as actor.",
            "explode": false,
            "in": "query",
            "name": "actor",
            "schema": {
              "description": "Keeps the events of the user of this id as actor.",
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Keeps the events about the user of this id.",
            "explode": false,
            "in": "query",
            "name": "subject",
            "schema": {
              "description": "Keeps the events about the user of this id.",
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Keeps the events that occurred at or after this time. An aggregated event is kept while its last occurrence is.",
            "explode": false,
            "in": "query",
            "name": "from",
            "schema": {
              "description": "Keeps the events that occurred at or after this time. An aggregated event is kept while its last occurrence is.",
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Keeps the events that occurred before this time, which must be after from. An aggregated event is kept when its first occurrence is.",
            "explode": false,
            "in": "query",
            "name": "to",
            "schema": {
              "description": "Keeps the events that occurred before this time, which must be after from. An aggregated event is kept when its first occurrence is.",
              "format": "date-time",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageAuditEvent"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "summary": "List the audit events",
        "tags": [
          "Audit"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "description": "Returns the user of the session.",
        "operationId": "get-current-user",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "summary": "Get the current user",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/meta": {
      "get": {
        "description": "Returns the name of the application and the build metadata of the server, without authentication.",
        "operationId": "get-meta",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Meta"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get the server metadata",
        "tags": [
          "Meta"
        ]
      }
    }
  }
}
