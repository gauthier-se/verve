{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "Meta": {
        "additionalProperties": false,
        "properties": {
          "buildDate": {
            "description": "When the server was built in RFC 3339 format, unknown for a development build.",
            "examples": [
              "2026-10-28T10:00:00Z"
            ],
            "type": "string"
          },
          "commit": {
            "description": "The commit the server was built from, unknown for a development build.",
            "examples": [
              "3f9a1c2"
            ],
            "type": "string"
          },
          "name": {
            "description": "The name of the application.",
            "examples": [
              "Verve"
            ],
            "type": "string"
          },
          "version": {
            "description": "The version of the server, dev for a development build.",
            "examples": [
              "1.4.0"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "commit",
          "buildDate"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "A stable machine-readable error code.",
            "type": "string"
          },
          "detail": {
            "description": "An explanation specific to this occurrence of the problem.",
            "type": "string"
          },
          "errors": {
            "description": "The individual errors behind the problem, for example one per invalid field.",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array"
          },
          "instance": {
            "description": "A URI reference that identifies this occurrence of the problem.",
            "type": "string"
          },
          "status": {
            "description": "The HTTP status code.",
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short summary of the problem type.",
            "type": "string"
          },
          "type": {
            "description": "A URI reference that identifies the problem type, about:blank when only the status matters.",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Verve API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/meta": {
      "get": {
        "description": "Returns the name of the application and the build metadata of the server, without authentication.",
        "operationId": "get-meta",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Meta"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get the server metadata",
        "tags": [
          "Meta"
        ]
      }
    }
  }
}
