{
  "components": {
    "schemas": {
      "AuditEvent": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "$ref": "#/components/schemas/AuditUser",
            "description": "The user who acted, left out for the system."
          },
          "clientIp": {
            "description": "The IP address of the client, left out outside requests.",
            "examples": [
              "203.0.113.7"
            ],
            "type": "string"
          },
          "count": {
            "description": "The number of occurrences of the event, more than 1 for a burst aggregated into one event.",
            "examples": [
              1
            ],
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "description": "The id of the event.",
            "examples": [
              42
            ],
            "format": "int64",
            "type": "integer"
          },
          "lastAt": {
            "description": "When the last occurrence of the event happened, occurredAt unless the event is aggregated.",
            "format": "date-time",
            "type": "string"
          },
          "occurredAt": {
            "description": "When the event occurred, the first of its occurrences for an aggregated event.",
            "format": "date-time",
            "type": "string"
          },
          "payload": {
            "description": "The details of the event, an object whose fields depend on its type."
          },
          "subject": {
            "$ref": "#/components/schemas/AuditUser",
            "description": "The user the event is about, left out when there is none."
          },
          "type": {
            "description": "The type of the event.",
            "examples": [
              "auth.login_failed"
            ],
            "type": "string"
          },
          "userAgent": {
            "description": "The user agent of the client, left out outside requests.",
            "examples": [
              "Mozilla/5.0 (iPhone)"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "occurredAt",
          "type",
          "payload",
          "count",
          "lastAt"
        ],
        "type": "object"
      },
      "AuditUser": {
        "additionalProperties": false,
        "properties": {
          "deleted": {
            "description": "Whether the user was deleted since the event.",
            "type": "boolean"
          },
          "id": {
            "description": "The id of the user.",
            "examples": [
              1
            ],
            "format": "int64",
            "type": "integer"
          },
          "username": {
            "description": "The username, left out when the user was deleted.",
            "examples": [
              "alice"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "deleted"
        ],
        "type": "object"
      },
      "ChangePasswordInputBody": {
        "additionalProperties": false,
        "properties": {
          "currentPassword": {
            "description": "The current password of the user.",
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "newPassword": {
            "description": "The new password: 12 to 128 characters, and not a common password.",
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object"
      },
      "CurrentUser": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "description": "The email address, left out when the user has none.",
            "examples": [
              "alice@example.com"
            ],
            "type": "string"
          },
          "id": {
            "description": "The id of the user.",
            "examples": [
              1
            ],
            "format": "int64",
            "type": "integer"
          },
          "role": {
            "description": "The role of the user.",
            "enum": [
              "admin",
              "member"
            ],
            "examples": [
              "member"
            ],
            "type": "string"
          },
          "timezone": {
            "description": "The IANA name of the timezone of the user, or null until they confirm one.",
            "examples": [
              "Europe/Paris"
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "username": {
            "description": "The username, in the case it was created with.",
            "examples": [
              "alice"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role",
          "timezone"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "Job": {
        "additionalProperties": false,
        "properties": {
          "attempts": {
            "description": "The number of failed attempts of the job. A lost lease is not one.",
            "examples": [
              5
            ],
            "format": "int64",
            "type": "integer"
          },
          "createdAt": {
            "description": "When the job was enqueued.",
            "format": "date-time",
            "type": "string"
          },
          "finishedAt": {
            "description": "When the job ended.",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "The id of the job.",
            "examples": [
              42
            ],
            "format": "int64",
            "type": "integer"
          },
          "kind": {
            "description": "The kind of the job.",
            "examples": [
              "backup.run"
            ],
            "type": "string"
          },
          "lastError": {
            "description": "The error of the last failure of the job, left out when it never failed.",
            "examples": [
              "disk full"
            ],
            "type": "string"
          },
          "status": {
            "description": "The status of the job.",
            "enum": [
              "completed",
              "failed",
              "cancelled"
            ],
            "examples": [
              "failed"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "status",
          "attempts",
          "createdAt",
          "finishedAt"
        ],
        "type": "object"
      },
      "LoginInputBody": {
        "additionalProperties": false,
        "properties": {
          "login": {
            "description": "The username or the email address, in any case.",
            "examples": [
              "alice"
            ],
            "maxLength": 254,
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "description": "The password, at most 128 characters.",
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "login",
          "password"
        ],
        "type": "object"
      },
      "Meta": {
        "additionalProperties": false,
        "properties": {
          "buildDate": {
            "description": "When the server was built in RFC 3339 format, unknown for a development build.",
            "examples": [
              "2026-10-28T10:00:00Z"
            ],
            "type": "string"
          },
          "commit": {
            "description": "The commit the server was built from, unknown for a development build.",
            "examples": [
              "3f9a1c2"
            ],
            "type": "string"
          },
          "name": {
            "description": "The name of the application.",
            "examples": [
              "Verve"
            ],
            "type": "string"
          },
          "version": {
            "description": "The version of the server, dev for a development build.",
            "examples": [
              "1.4.0"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "commit",
          "buildDate"
        ],
        "type": "object"
      },
      "PageAuditEvent": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "description": "The items of the page, newest first.",
            "items": {
              "$ref": "#/components/schemas/AuditEvent"
            },
            "type": "array"
          },
          "nextCursor": {
            "description": "The cursor of the next page, left out on the last page.",
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "PageJob": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "description": "The items of the page, newest first.",
            "items": {
              "$ref": "#/components/schemas/Job"
            },
            "type": "array"
          },
          "nextCursor": {
            "description": "The cursor of the next page, left out on the last page.",
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "Preferences": {
        "additionalProperties": false,
        "properties": {
          "timezone": {
            "description": "The IANA name of the timezone of the user, or null until they confirm one: their days are in UTC until then.",
            "examples": [
              "Europe/Paris"
            ],
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "timezone"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "A stable machine-readable error code.",
            "type": "string"
          },
          "detail": {
            "description": "An explanation specific to this occurrence of the problem.",
            "type": "string"
          },
          "errors": {
            "description": "The individual errors behind the problem, for example one per invalid field.",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array"
          },
          "instance": {
            "description": "A URI reference that identifies this occurrence of the problem.",
            "type": "string"
          },
          "status": {
            "description": "The HTTP status code.",
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short summary of the problem type.",
            "type": "string"
          },
          "type": {
            "description": "A URI reference that identifies the problem type, about:blank when only the status matters.",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "type": "object"
      },
      "Session": {
        "additionalProperties": false,
        "properties": {
          "browser": {
            "description": "The browser that the user agent of the login names, left out when unknown. It is only a hint.",
            "examples": [
              "Safari"
            ],
            "type": "string"
          },
          "clientIp": {
            "description": "The IP address of the client that logged in, left out when unknown.",
            "examples": [
              "203.0.113.7"
            ],
            "type": "string"
          },
          "current": {
            "description": "Whether this is the session of the request.",
            "type": "boolean"
          },
          "device": {
            "description": "The device that the user agent of the login names, left out when unknown. It is only a hint.",
            "examples": [
              "iPhone"
            ],
            "type": "string"
          },
          "id": {
            "description": "The public id of the session, which names it in DELETE /api/v1/account/sessions/{id}.",
            "type": "string"
          },
          "lastSeenAt": {
            "description": "When the session was last used, to the minute.",
            "format": "date-time",
            "type": "string"
          },
          "method": {
            "description": "How the user logged in.",
            "enum": [
              "password"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "method",
          "lastSeenAt",
          "current"
        ],
        "type": "object"
      },
      "SessionsOutputBody": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "description": "The sessions, most recently used first.",
            "items": {
              "$ref": "#/components/schemas/Session"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "SetupInputBody": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "description": "The password of the admin: 12 to 128 characters, and not a common password.",
            "type": "string"
          },
          "token": {
            "description": "The setup token, from the setup link that verve serve writes on stderr while no user exists.",
            "type": "string"
          },
          "username": {
            "description": "The username of the admin: 1 to 64 characters, without @, whitespace, control or invisible characters.",
            "examples": [
              "alice"
            ],
            "type": "string"
          }
        },
        "required": [
          "token",
          "username",
          "password"
        ],
        "type": "object"
      },
      "SetupStatusOutputBody": {
        "additionalProperties": false,
        "properties": {
          "required": {
            "description": "Whether the instance has no user yet: the first admin is then created with the setup token.",
            "type": "boolean"
          }
        },
        "required": [
          "required"
        ],
        "type": "object"
      },
      "UpdatePreferencesInputBody": {
        "additionalProperties": false,
        "properties": {
          "timezone": {
            "description": "The IANA name of the timezone of the user. Left out, it is unchanged.",
            "examples": [
              "Europe/Paris"
            ],
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "description": "The session cookie set at login, named `__Host-verve_session` when the public URL uses https. A `POST`, `PUT`, `PATCH` or `DELETE` must also send the header `Verve-Csrf: 1` and an `Origin` matching the public URL.",
        "in": "cookie",
        "name": "verve_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Verve API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/account/audit": {
      "get": {
        "description": "Returns the audit events whose actor or subject is the user of the session, newest first.",
        "operationId": "list-account-audit-events",
        "parameters": [
          {
            "description": "The nextCursor of the previous page, left out for the first page.",
            "explode": false,
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "The nextCursor of the previous page, left out for the first page.",
              "type": "string"
            }
          },
          {
            "description": "The maximum number of items of the page, at most 200: a larger limit counts as 200.",
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "description": "The maximum number of items of the page, at most 200: a larger limit counts as 200.",
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageAuditEvent"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "summary": "List the audit events of the current user",
        "tags": [
          "Audit"
        ]
      }
    },
    "/api/v1/account/password": {
      "post": {
        "description": "Changes the password and revokes every other session of the user, keeping the current one. A wrong current password answers 403 `invalid_credentials` and counts as a failed login of the user, which delays their attempts with 429 `rate_limited` as the login does. A new password that breaks the rules answers 422 with the code of the rule: `password_too_short`, `password_too_long` or `password_too_common`.",
        "operationId": "change-password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "summary": "Change the password of the current user",
        "tags": [
          "Account"
        ]
      }
    },
    "/api/v1/account/preferences": {
      "get": {
        "description": "Returns the preferences of the user of the session.",
        "operationId": "get-preferences",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preferences"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "summary": "Get the preferences of the current user",
        "tags": [
          "Account"
        ]
      },
      "patch": {
        "description": "Changes the preferences given in the body, keeps the others, and returns the preferences. A timezone that is not an IANA name, such as `Europe/Paris`, answers 422 `timezone_invalid`.",
        "operationId": "update-preferences",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePreferencesInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preferences"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "summary": "Change the preferences of the current user",
        "tags": [
          "Account"
        ]
      }
    },
    "/api/v1/account/sessions": {
      "delete": {
        "description": "Revokes every session of the user but the current one.",
        "operationId": "revoke-other-sessions",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "summary": "Revoke the other sessions of the current user",
        "tags": [
          "Account"
        ]
      },
      "get": {
        "description": "Returns the valid sessions of the user, most recently used first, the current one flagged.",
        "operationId": "list-sessions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionsOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "summary": "List the sessions of the current user",
        "tags": [
          "Account"
        ]
      }
    },
    "/api/v1/account/sessions/{id}": {
      "delete": {
        "description": "Revokes the session of the user with this public id. A session of another user answers 404.",
        "operationId": "revoke-session",
        "parameters": [
          {
            "description": "The public id of the session.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "The public id of the session.",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "summary": "Revoke a session of the current user",
        "tags": [
          "Account"
        ]
      }
    },
    "/api/v1/admin/audit": {
      "get": {
        "description": "Returns every audit event, newest first, for an admin. The filters combine.",
        "operationId": "list-admin-audit-events",
        "parameters": [
          {
            "description": "The nextCursor of the previous page, left out for the first page.",
